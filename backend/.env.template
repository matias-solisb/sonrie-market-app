STORE_CORS=http://localhost:8000,https://docs.medusajs.com
# Usado por el subscriber de reset de contraseña (src/subscribers/customer-password-reset.ts)
# para armar el link que va en el correo. Cambiar en producción a la URL real del storefront.
STOREFRONT_URL=http://localhost:8000
# Provider de correo (src/utils/email-delivery.ts): "local" = sin correo real; en
# desarrollo el link de recuperación sale destacado en la consola, en producción
# NO se genera (no puede quedar en los logs). "acs" cuando exista Azure
# Communication Services (tarea 5.3 de infra).
NOTIFICATION_PROVIDER=local
# NODE_ENV: en QA/PRD debe ser "production" ("medusa start" lo usa por defecto si no se define).
# STORE_CORS, ADMIN_CORS, AUTH_CORS y DATABASE_URL son obligatorias en producción.
ADMIN_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
AUTH_CORS=http://localhost:7000,http://localhost:7001,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Firma de tokens (JWT_SECRET) y cookies de sesión (COOKIE_SECRET). Solo para desarrollo.
# En QA/PRD: secretos nuevos, distintos entre sí y por ambiente, de al menos 32
# caracteres, cargados desde Azure Key Vault. Con NODE_ENV=production el backend
# no arranca si faltan, valen "supersecret" o son cortos (src/utils/env-validation.ts).
# Generar: openssl rand -base64 48
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres@localhost/$DB_NAME
DB_NAME=medusa-backend
# Auditoría de acceso (src/utils/auth-audit.ts). Clave del HMAC que convierte el RUT
# en `rut_ref` en los logs. Mínimo 32 caracteres, distinta por ambiente, en Key Vault.
# Si cambia, los rut_ref anteriores ya no se pueden recalcular. Obligatorio con NODE_ENV=production.
# Generar: openssl rand -hex 32
AUDIT_HASH_SECRET=
# Cuántos proxies de confianza agregan X-Forwarded-For antes del backend (0 = tomar
# la primera IP, solo desarrollo). Calibrar en DEV de Azure.
AUDIT_TRUSTED_PROXY_HOPS=0
